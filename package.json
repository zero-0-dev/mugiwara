{
  "name": "mugiwara",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform manga reader with extensible plugin architecture",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "build:mobile:android": "cd apps/mobile && npx expo run:android --variant release",
    "build:server:deploy": "turbo build --filter=@mugiwara-manga/server && pnpm --filter=@mugiwara-manga/server deploy --legacy apps/server/deploy",
    "build:desktop:linux": "cd apps/desktop && npm run package:linux",
    "build:desktop:win": "cd apps/desktop && npm run package:win"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
