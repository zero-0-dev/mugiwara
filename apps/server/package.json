{
  "name": "@mugiwara/server",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --include \"./src/**/*\" src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@mugiwara/plugin-api": "workspace:*",
    "@mugiwara/source-local": "workspace:*",
    "@mugiwara/source-mangadex": "workspace:*",
    "@mugiwara/storage-local": "workspace:*",
    "@mugiwara/types": "workspace:*",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@mugiwara/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
