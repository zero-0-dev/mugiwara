{
  "extends": "@mugiwara-manga/tsconfig/react",
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.mts"],
  "exclude": ["node_modules", "dist"]
}
