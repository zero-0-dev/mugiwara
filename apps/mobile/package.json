{
  "name": "@mugiwara-manga/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "pnpm --filter @mugiwara-manga/web build",
    "sync": "pnpm build:web && cap sync",
    "sync:android": "pnpm build:web && cap sync android",
    "sync:ios": "pnpm build:web && cap sync ios",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "pnpm build:web && cap run android",
    "run:ios": "pnpm build:web && cap run ios",
    "build:android:debug": "pnpm build:web && cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "pnpm build:web && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
