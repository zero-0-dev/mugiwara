{
  "name": "@mugiwara-manga/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && vite build",
    "build:main": "tsc -p src/main/tsconfig.json",
    "build:preload": "tsc -p src/preload/tsconfig.json",
    "build:renderer": "vite build",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "npm run build:main && npm run build:preload && electron dist/main/index.js --inspect=5858",
    "dev:renderer": "vite",
    "clean": "rm -rf dist release",
    "typecheck": "tsc --noEmit",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:all": "npm run build && electron-builder --linux --win --mac"
  },
  "build": {
    "appId": "dev.zero.mugiwara",
    "productName": "Mugiwara",
    "icon": "buildResources/icon.png",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/server-deploy/dist",
        "to": "server"
      },
      {
        "from": "../../dist/server-deploy/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "../../dist/server-deploy/drizzle",
        "to": "drizzle"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "mac": {
      "target": ["zip"],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@mugiwara-manga/types": "workspace:*",
    "@tanstack/react-query": "^5.97.0",
    "lucide-react": "^1.11.0"
  },
  "devDependencies": {
    "@mugiwara-manga/tsconfig": "workspace:*",
    "@types/node": "^20.10.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  }
}
