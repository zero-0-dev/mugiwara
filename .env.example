# Build-time tracker OAuth credentials.
#
# Copy this file to `.env` (gitignored) before running a packaging command such
# as `pnpm build:desktop:linux`. Release builds can also provide these as real
# environment variables; real env vars take precedence over .env files.
#
# Never commit your `.env` file.

# AniList OAuth application. AniList requires an app secret for the
# authorization-code flow.
MUGIWARA_ANILIST_CLIENT_ID=
MUGIWARA_ANILIST_CLIENT_SECRET=
# Must exactly match the redirect URI registered with AniList.
MUGIWARA_ANILIST_REDIRECT_URI=http://127.0.0.1:3001/api/trackers/anilist/auth/callback

# MyAnimeList public OAuth client. Leave the secret unset for a public client.
MUGIWARA_MAL_CLIENT_ID=
MUGIWARA_MAL_CLIENT_SECRET=
# Must exactly match the redirect URI registered with MyAnimeList.
MUGIWARA_MAL_REDIRECT_URI=http://127.0.0.1:3001/api/trackers/myanimelist/auth/callback

# Optional MyAnimeList User-Agent override.
# MUGIWARA_MAL_USER_AGENT=Mugiwara/0.1 (+https://github.com/zero-0-dev/mugiwara)
