{
  "name": "mugiwara",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform manga reader with extensible plugin architecture",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "build:app:android": "node scripts/build.mjs app:android",
    "build:desktop:linux": "node scripts/build.mjs desktop:linux",
    "build:desktop:win": "node scripts/build.mjs desktop:win",
    "build:desktop:osx": "node scripts/build.mjs desktop:mac",
    "build:server:deploy": "turbo build --filter=@mugiwara-manga/server"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
