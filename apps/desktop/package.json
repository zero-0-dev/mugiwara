{
  "name": "@mugiwara-manga/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build:main && npm run build:preload",
    "build:main": "tsc -p src/main/tsconfig.json",
    "build:preload": "tsc -p src/preload/tsconfig.json",
    "dev": "npm run dev:main",
    "dev:main": "npm run build:main && npm run build:preload && electron dist/main/index.js --inspect=5858",
    "dev:web": "pnpm --filter @mugiwara-manga/web dev",
    "clean": "rm -rf dist release",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "package:linux": "node ../../scripts/build.mjs desktop:linux",
    "package:mac": "node ../../scripts/build.mjs desktop:mac",
    "package:win": "node ../../scripts/build.mjs desktop:win"
  },
  "build": {
    "appId": "dev.zero.mugiwara",
    "productName": "Mugiwara",
    "directories": {
      "buildResources": "buildResources"
    },
    "protocols": [
      {
        "name": "Mugiwara",
        "schemes": ["mugiwara"]
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "buildResources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../server/dist",
        "to": "server"
      },
      {
        "from": "../server/deploy/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "../server/drizzle",
        "to": "drizzle"
      },
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "executableName": "mugiwara"
    },
    "mac": {
      "target": ["zip"],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@mugiwara-manga/tsconfig": "workspace:*",
    "@mugiwara-manga/web": "workspace:*",
    "@types/node": "^20.10.5",
    "concurrently": "^8.2.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "typescript": "^5.3.3"
  }
}
